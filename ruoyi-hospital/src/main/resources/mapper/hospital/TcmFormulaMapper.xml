<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.hospital.mapper.TcmFormulaMapper">

    <resultMap type="TcmFormula" id="TcmFormulaResult">
        <id     property="id"              column="id"              />
        <result property="name"            column="name"            />
        <result property="category"        column="category"        />
        <result property="description"     column="description"     />
        <result property="source"          column="source"          />
        <result property="isActive"        column="is_active"       />
        <result property="deletedAt"       column="deleted_at"      />
        <result property="createTime"      column="create_time"     />
        <result property="updateTime"      column="update_time"     />
    </resultMap>

    <sql id="selectTcmFormulaVo">
        select id, name, category, description, source,
               is_active, deleted_at, create_time, update_time
        from tcm_formula
    </sql>

    <select id="selectTcmFormulaList" parameterType="TcmFormula" resultMap="TcmFormulaResult">
        <include refid="selectTcmFormulaVo"/>
        <where>
            <if test="name != null and name != ''">
                AND name like concat('%', #{name}, '%')
            </if>
            <if test="category != null and category != ''">
                AND category = #{category}
            </if>
            <if test="isActive != null">
                AND is_active = #{isActive}
            </if>
            AND deleted_at IS NULL
        </where>
        order by create_time desc
    </select>

    <select id="selectTcmFormulaById" parameterType="String" resultMap="TcmFormulaResult">
        <include refid="selectTcmFormulaVo"/>
        where id = #{id}
    </select>

    <insert id="insertTcmFormula" parameterType="TcmFormula">
        insert into tcm_formula (
            id,
            <if test="name != null and name != ''">name,</if>
            <if test="category != null and category != ''">category,</if>
            <if test="description != null and description != ''">description,</if>
            <if test="source != null and source != ''">source,</if>
            <if test="isActive != null">is_active,</if>
            create_time
        )values(
            #{id},
            <if test="name != null and name != ''">#{name},</if>
            <if test="category != null and category != ''">#{category},</if>
            <if test="description != null and description != ''">#{description},</if>
            <if test="source != null and source != ''">#{source},</if>
            <if test="isActive != null">#{isActive},</if>
            sysdate()
        )
    </insert>

    <update id="updateTcmFormula" parameterType="TcmFormula">
        update tcm_formula
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="category != null">category = #{category},</if>
            <if test="description != null">description = #{description},</if>
            <if test="source != null">source = #{source},</if>
            <if test="isActive != null">is_active = #{isActive},</if>
            deleted_at = #{deletedAt},
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteTcmFormulaById" parameterType="String">
        delete from tcm_formula where id = #{id}
    </delete>

</mapper>
