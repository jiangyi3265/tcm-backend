<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.hospital.mapper.TcmMeridianMapper">
    <resultMap type="TcmMeridian" id="TcmMeridianResult">
        <id     property="id"             column="id"              />
        <result property="name"           column="name"            />
        <result property="englishName"    column="english_name"    />
        <result property="abbr"           column="abbr"            />
        <result property="category"       column="category"        />
        <result property="organ"          column="organ"           />
        <result property="pathway"        column="pathway"         />
        <result property="acupointCount"  column="acupoint_count"  />
        <result property="indication"     column="indication"      />
        <result property="notes"          column="notes"           />
        <result property="isActive"       column="is_active"       />
        <result property="deletedAt"      column="deleted_at"      />
        <result property="createTime"     column="create_time"     />
        <result property="updateTime"     column="update_time"     />
    </resultMap>
    <sql id="selectColumns">
        id, name, english_name, abbr, category, organ, pathway, acupoint_count, indication,
        notes, is_active, deleted_at, create_time, update_time
    </sql>
    <select id="selectTcmMeridianList" parameterType="TcmMeridian" resultMap="TcmMeridianResult">
        select <include refid="selectColumns"/> from tcm_meridian
        <where>
            AND deleted_at IS NULL
            <if test="name != null and name != ''">AND name like concat('%', #{name}, '%')</if>
            <if test="category != null and category != ''">AND category = #{category}</if>
            <if test="isActive != null">AND is_active = #{isActive}</if>
        </where>
        order by id asc
    </select>
    <select id="selectTcmMeridianById" parameterType="String" resultMap="TcmMeridianResult">
        select <include refid="selectColumns"/> from tcm_meridian where id = #{id}
    </select>
    <insert id="insertTcmMeridian" parameterType="TcmMeridian">
        insert into tcm_meridian (id, name, english_name, abbr, category, organ, pathway, acupoint_count,
            indication, notes, is_active, deleted_at, create_time)
        values (#{id}, #{name}, #{englishName}, #{abbr}, #{category}, #{organ}, #{pathway}, #{acupointCount},
            #{indication}, #{notes}, #{isActive}, #{deletedAt}, #{createTime})
    </insert>
    <update id="updateTcmMeridian" parameterType="TcmMeridian">
        update tcm_meridian
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="englishName != null">english_name = #{englishName},</if>
            <if test="abbr != null">abbr = #{abbr},</if>
            <if test="category != null">category = #{category},</if>
            <if test="organ != null">organ = #{organ},</if>
            <if test="pathway != null">pathway = #{pathway},</if>
            <if test="acupointCount != null">acupoint_count = #{acupointCount},</if>
            <if test="indication != null">indication = #{indication},</if>
            <if test="notes != null">notes = #{notes},</if>
            <if test="isActive != null">is_active = #{isActive},</if>
            deleted_at = #{deletedAt},
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>
    <delete id="deleteTcmMeridianById" parameterType="String">
        delete from tcm_meridian where id = #{id}
    </delete>
</mapper>
