<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.hospital.mapper.TcmInventoryItemMapper">

    <resultMap type="TcmInventoryItem" id="TcmInventoryItemResult">
        <id     property="id"               column="id"                />
        <result property="name"             column="name"              />
        <result property="category"         column="category"          />
        <result property="unit"             column="unit"              />
        <result property="quantity"         column="quantity"          />
        <result property="pricePerUnit"     column="price_per_unit"    />
        <result property="minStockLevel"    column="min_stock_level"   />
        <result property="supplier"         column="supplier"          />
        <result property="supplierId"      column="supplier_id"       />
        <result property="gramsPerPacket"   column="grams_per_packet"  />
        <result property="branchId"         column="branch_id"         />
        <result property="isActive"         column="is_active"         />
        <result property="deletedAt"        column="deleted_at"        />
        <result property="herbDictId"       column="herb_dict_id"      />
        <result property="payload"          column="payload"           />
        <result property="createTime"       column="create_time"       />
        <result property="updateTime"       column="update_time"       />
    </resultMap>

    <sql id="selectTcmInventoryItemVo">
        select id, name, category, unit, quantity, price_per_unit, min_stock_level, supplier, supplier_id,
               grams_per_packet, branch_id, is_active, deleted_at, herb_dict_id, payload, create_time, update_time
        from tcm_inventory_item
    </sql>

    <select id="selectTcmInventoryItemList" parameterType="TcmInventoryItem" resultMap="TcmInventoryItemResult">
        <include refid="selectTcmInventoryItemVo"/>
        <where>
            <if test="name != null and name != ''">
                AND name like concat('%', #{name}, '%')
            </if>
            <if test="category != null and category != ''">
                AND category = #{category}
            </if>
            <if test="supplier != null and supplier != ''">
                AND supplier like concat('%', #{supplier}, '%')
            </if>
            <if test="branchId != null">
                AND branch_id = #{branchId}
            </if>
            <if test="isActive != null">
                AND is_active = #{isActive}
            </if>
            AND deleted_at IS NULL
        </where>
    </select>

    <select id="selectTcmInventoryItemById" parameterType="String" resultMap="TcmInventoryItemResult">
        <include refid="selectTcmInventoryItemVo"/>
        where id = #{id}
    </select>

    <select id="selectTcmInventoryItemByName" resultMap="TcmInventoryItemResult">
        <include refid="selectTcmInventoryItemVo"/>
        where name = #{name} and category = #{category} and is_active = 1 and deleted_at is null
        limit 1
    </select>

    <select id="selectTcmInventoryItemsByName" resultMap="TcmInventoryItemResult">
        <include refid="selectTcmInventoryItemVo"/>
        where name = #{name} and category = #{category} and is_active = 1 and deleted_at is null
        order by quantity desc
    </select>

    <insert id="insertTcmInventoryItem" parameterType="TcmInventoryItem">
        insert into tcm_inventory_item (
            id,
            <if test="name != null and name != ''">name,</if>
            <if test="category != null and category != ''">category,</if>
            <if test="unit != null and unit != ''">unit,</if>
            <if test="quantity != null">quantity,</if>
            <if test="pricePerUnit != null">price_per_unit,</if>
            <if test="minStockLevel != null">min_stock_level,</if>
            <if test="supplier != null and supplier != ''">supplier,</if>
            <if test="supplierId != null">supplier_id,</if>
            <if test="gramsPerPacket != null">grams_per_packet,</if>
            <if test="branchId != null">branch_id,</if>
            <if test="isActive != null">is_active,</if>
            <if test="deletedAt != null">deleted_at,</if>
            <if test="herbDictId != null">herb_dict_id,</if>
            <if test="payload != null">payload,</if>
            create_time
        )values(
            #{id},
            <if test="name != null and name != ''">#{name},</if>
            <if test="category != null and category != ''">#{category},</if>
            <if test="unit != null and unit != ''">#{unit},</if>
            <if test="quantity != null">#{quantity},</if>
            <if test="pricePerUnit != null">#{pricePerUnit},</if>
            <if test="minStockLevel != null">#{minStockLevel},</if>
            <if test="supplier != null and supplier != ''">#{supplier},</if>
            <if test="supplierId != null">#{supplierId},</if>
            <if test="gramsPerPacket != null">#{gramsPerPacket},</if>
            <if test="branchId != null">#{branchId},</if>
            <if test="isActive != null">#{isActive},</if>
            <if test="deletedAt != null">#{deletedAt},</if>
            <if test="herbDictId != null">#{herbDictId},</if>
            <if test="payload != null">#{payload},</if>
            sysdate()
        )
    </insert>

    <update id="updateTcmInventoryItem" parameterType="TcmInventoryItem">
        update tcm_inventory_item
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="category != null and category != ''">category = #{category},</if>
            <if test="unit != null and unit != ''">unit = #{unit},</if>
            <if test="quantity != null">quantity = #{quantity},</if>
            <if test="pricePerUnit != null">price_per_unit = #{pricePerUnit},</if>
            <if test="minStockLevel != null">min_stock_level = #{minStockLevel},</if>
            <if test="supplier != null and supplier != ''">supplier = #{supplier},</if>
            <if test="supplierId != null">supplier_id = #{supplierId},</if>
            <if test="gramsPerPacket != null">grams_per_packet = #{gramsPerPacket},</if>
            <if test="branchId != null">branch_id = #{branchId},</if>
            <if test="isActive != null">is_active = #{isActive},</if>
            deleted_at = #{deletedAt},
            <if test="herbDictId != null">herb_dict_id = #{herbDictId},</if>
            payload = #{payload},
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteTcmInventoryItemById" parameterType="String">
        delete from tcm_inventory_item where id = #{id}
    </delete>

    <delete id="deleteTcmInventoryItemByIds" parameterType="String">
        delete from tcm_inventory_item where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectByHerbDictId" resultMap="TcmInventoryItemResult">
        <include refid="selectTcmInventoryItemVo"/>
        where herb_dict_id = #{herbDictId} and is_active = 1 and deleted_at is null
        order by quantity desc
    </select>

</mapper>
