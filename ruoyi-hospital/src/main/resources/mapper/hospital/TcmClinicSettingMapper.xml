<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.hospital.mapper.TcmClinicSettingMapper">

    <resultMap type="TcmClinicSetting" id="TcmClinicSettingResult">
        <id     property="settingKey"        column="setting_key"      />
        <result property="settingValue"      column="setting_value"    />
        <result property="updateTime"        column="update_time"      />
    </resultMap>

    <sql id="selectTcmClinicSettingVo">
        select setting_key, setting_value, update_time
        from tcm_clinic_setting
    </sql>

    <select id="selectAllSettings" resultMap="TcmClinicSettingResult">
        <include refid="selectTcmClinicSettingVo"/>
        order by setting_key
    </select>

    <select id="selectSettingByKey" parameterType="String" resultMap="TcmClinicSettingResult">
        <include refid="selectTcmClinicSettingVo"/>
        where setting_key = #{settingKey}
    </select>

    <select id="selectTcmClinicSettingList" parameterType="TcmClinicSetting" resultMap="TcmClinicSettingResult">
        <include refid="selectTcmClinicSettingVo"/>
        <where>
            <if test="settingKey != null and settingKey != ''">
                AND setting_key like concat('%', #{settingKey}, '%')
            </if>
        </where>
        order by setting_key
    </select>

    <insert id="insertSetting" parameterType="TcmClinicSetting">
        replace into tcm_clinic_setting (
            setting_key,
            setting_value,
            update_time
        )values(
            #{settingKey},
            #{settingValue},
            sysdate()
        )
    </insert>

    <update id="updateSetting" parameterType="TcmClinicSetting">
        update tcm_clinic_setting
        <set>
            <if test="settingValue != null">setting_value = #{settingValue},</if>
            update_time = sysdate()
        </set>
        where setting_key = #{settingKey}
    </update>

    <delete id="deleteSettingByKey" parameterType="String">
        delete from tcm_clinic_setting where setting_key = #{settingKey}
    </delete>

    <delete id="deleteSettingByKeys" parameterType="String">
        delete from tcm_clinic_setting where setting_key in
        <foreach item="settingKey" collection="array" open="(" separator="," close=")">
            #{settingKey}
        </foreach>
    </delete>

</mapper>
