<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.hospital.mapper.TcmAppointmentMapper">

    <resultMap type="TcmAppointment" id="TcmAppointmentResult">
        <id     property="id"               column="id"               />
        <result property="patientId"        column="patient_id"       />
        <result property="practitionerId"   column="practitioner_id"  />
        <result property="roomId"           column="room_id"          />
        <result property="serviceType"      column="service_type"     />
        <result property="startTime"        column="start_time"       />
        <result property="endTime"          column="end_time"         />
        <result property="status"           column="status"           />
        <result property="branchId"         column="branch_id"        />
        <result property="intakeToken"      column="intake_token"     />
        <result property="intakeSubmitted"  column="intake_submitted" />
        <result property="payload"          column="payload"          />
        <result property="createTime"       column="create_time"      />
        <result property="updateTime"       column="update_time"      />
    </resultMap>

    <sql id="selectTcmAppointmentVo">
        select id, patient_id, practitioner_id, room_id, service_type, start_time, end_time,
               status, branch_id, intake_token, intake_submitted, payload, create_time, update_time
        from tcm_appointment
    </sql>

    <select id="selectTcmAppointmentList" parameterType="TcmAppointment" resultMap="TcmAppointmentResult">
        <include refid="selectTcmAppointmentVo"/>
        <where>
            <if test="patientId != null">
                AND patient_id = #{patientId}
            </if>
            <if test="practitionerId != null">
                AND practitioner_id = #{practitionerId}
            </if>
            <if test="roomId != null">
                AND room_id = #{roomId}
            </if>
            <if test="serviceType != null and serviceType != ''">
                AND service_type = #{serviceType}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="branchId != null">
                AND branch_id = #{branchId}
            </if>
        </where>
    </select>

    <select id="selectTcmAppointmentById" parameterType="String" resultMap="TcmAppointmentResult">
        <include refid="selectTcmAppointmentVo"/>
        where id = #{id}
    </select>

    <select id="selectTcmAppointmentByIntakeToken" parameterType="String" resultMap="TcmAppointmentResult">
        <include refid="selectTcmAppointmentVo"/>
        where intake_token = #{intakeToken}
    </select>

    <select id="selectOverlappingAppointments" resultMap="TcmAppointmentResult">
        select id, patient_id, practitioner_id, room_id, service_type, start_time, end_time,
               status, branch_id, intake_token, intake_submitted, payload, create_time, update_time
        from tcm_appointment
        where status != 'cancelled'
        AND (
            (practitioner_id = #{practitionerId} OR room_id = #{roomId})
        )
        AND start_time &lt; #{endTime}
        AND end_time &gt; #{startTime}
        <if test="excludeId != null and excludeId != ''">
            AND id != #{excludeId}
        </if>
    </select>

    <insert id="insertTcmAppointment" parameterType="TcmAppointment">
        insert into tcm_appointment (
            id,
            <if test="patientId != null">patient_id,</if>
            <if test="practitionerId != null">practitioner_id,</if>
            <if test="roomId != null">room_id,</if>
            <if test="serviceType != null and serviceType != ''">service_type,</if>
            <if test="startTime != null">start_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="branchId != null">branch_id,</if>
            <if test="intakeToken != null">intake_token,</if>
            <if test="intakeSubmitted != null">intake_submitted,</if>
            <if test="payload != null and payload != ''">payload,</if>
            create_time
        )values(
            #{id},
            <if test="patientId != null">#{patientId},</if>
            <if test="practitionerId != null">#{practitionerId},</if>
            <if test="roomId != null">#{roomId},</if>
            <if test="serviceType != null and serviceType != ''">#{serviceType},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="branchId != null">#{branchId},</if>
            <if test="intakeToken != null">#{intakeToken},</if>
            <if test="intakeSubmitted != null">#{intakeSubmitted},</if>
            <if test="payload != null and payload != ''">#{payload},</if>
            sysdate()
        )
    </insert>

    <update id="updateTcmAppointment" parameterType="TcmAppointment">
        update tcm_appointment
        <set>
            <if test="patientId != null">patient_id = #{patientId},</if>
            <if test="practitionerId != null">practitioner_id = #{practitionerId},</if>
            <if test="roomId != null">room_id = #{roomId},</if>
            <if test="serviceType != null and serviceType != ''">service_type = #{serviceType},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="branchId != null">branch_id = #{branchId},</if>
            intake_token = #{intakeToken},
            <if test="intakeSubmitted != null">intake_submitted = #{intakeSubmitted},</if>
            <if test="payload != null">payload = #{payload},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteTcmAppointmentById" parameterType="String">
        delete from tcm_appointment where id = #{id}
    </delete>

    <delete id="deleteTcmAppointmentByIds" parameterType="String">
        delete from tcm_appointment where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
